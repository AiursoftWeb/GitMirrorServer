@using Aiursoft.WebTools
@model Aiursoft.GitMirrorServer.Models.HistoryViewModels.DetailsViewModel
@inject IViewLocalizer Localizer

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">@Localizer["Mirror run results"]</h1>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (!Model.Job.EndTime.HasValue)
            {
                <span class="badge bg-primary">@Localizer["Running"]</span>
            }
            else if (Model.Job.IsSuccess && string.IsNullOrEmpty(Model.Job.ErrorMessage))
            {
                <span class="badge bg-success">@Localizer["Succeeded"]</span>
            }
            else
            {
                <span class="badge bg-danger">@Localizer["Failed"]</span>
            }
            <span class="text-muted">@Localizer["Started"] <span data-utc-time="@Model.Job.StartTime.ToHtmlDateTime()"></span></span>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" aria-hidden="true"></i>@Localizer["Back to History"]
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card h-100 mb-0"><div class="card-body">
            <div class="text-muted small mb-1">@Localizer["Succeeded"]</div>
            <div class="h3 mb-0 text-success">@Model.Job.SuccessCount</div>
        </div></div>
    </div>
    <div class="col-4">
        <div class="card h-100 mb-0"><div class="card-body">
            <div class="text-muted small mb-1">@Localizer["Failed"]</div>
            <div class="h3 mb-0 text-danger">@Model.Job.FailureCount</div>
        </div></div>
    </div>
    <div class="col-4">
        <div class="card h-100 mb-0"><div class="card-body">
            <div class="text-muted small mb-1">@Localizer["Total repositories"]</div>
            <div class="h3 mb-0">@Model.Job.TotalCount</div>
        </div></div>
    </div>
</div>

@if (!Model.Job.EndTime.HasValue)
{
    <p class="text-muted">@Localizer["This run is still in progress. Refresh to see the latest results."]</p>
}

@if (!string.IsNullOrEmpty(Model.Job.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        <div class="alert-icon"><i class="align-middle" data-lucide="alert-triangle" aria-hidden="true"></i></div>
        <div class="alert-message text-break"><strong>@Localizer["Run error"]:</strong> @Model.Job.ErrorMessage</div>
    </div>
}

<h2 class="h5 mb-2">@Localizer["Repository results"]</h2>
<p class="text-muted mb-3">@Localizer["Expand a repository to inspect its log. Failed results are expanded automatically."]</p>

@if (!Model.Job.RepoExecutions.Any())
{
    <div class="card"><div class="card-body text-muted">
        @Localizer["No repository results have been recorded for this run."]
    </div></div>
}

@foreach (var repo in Model.Job.RepoExecutions.OrderBy(repo => repo.IsSuccess).ThenBy(repo => repo.RepoName))
{
    <details class="card mb-3" open="@(!repo.IsSuccess)">
        <summary class="card-header text-break">
            <span class="fw-semibold">@repo.FromOrg / @repo.RepoName</span>
            <span class="badge bg-@(repo.IsSuccess ? "success" : "danger") ms-2">@(repo.IsSuccess ? Localizer["Succeeded"] : Localizer["Failed"])</span>
        </summary>
        <div class="card-body">
            <p class="text-muted text-break">@Localizer["Source"]: <strong>@repo.FromOrg</strong> <span aria-hidden="true">→</span> @Localizer["Target"]: <strong>@repo.TargetOrg / @repo.RepoName</strong></p>
            @if (!string.IsNullOrEmpty(repo.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <div class="alert-message text-break"><strong>@Localizer["Error"]:</strong> @repo.ErrorMessage</div>
                </div>
            }
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h3 class="h6 mb-0">@Localizer["Log"]</h3>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="small text-muted" role="status" data-copy-status></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-log="log-@repo.Id">
                        <i class="align-middle me-1" data-lucide="copy" aria-hidden="true"></i>@Localizer["Copy log"]
                    </button>
                </div>
            </div>
            <pre id="log-@repo.Id" class="bg-body-tertiary p-3 rounded mb-0" style="max-height: 400px; overflow: auto;">@repo.Log</pre>
        </div>
    </details>
}

<div class="d-none" id="history-copy-messages" aria-hidden="true">
    <span data-key="copied">@Localizer["Log copied."]</span>
    <span data-key="failed">@Localizer["Copy failed. Select the log text and copy it manually."]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/history-details.js" asp-append-version="true" defer></script>
}
