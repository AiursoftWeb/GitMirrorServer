@using Aiursoft.WebTools
@model Aiursoft.GitMirrorServer.Models.HistoryViewModels.IndexViewModel
@inject IViewLocalizer Localizer

<h1 class="h3 mb-2">@Localizer["Mirror history"]</h1>
<p class="text-muted mb-4">@Localizer["Open a mirror run to inspect repository results and logs."]</p>

<div class="card">
    <div class="card-body">
        @if (!Model.History.Any())
        {
            <div class="text-center py-4">
                <i class="text-muted mb-3" data-lucide="history" aria-hidden="true"></i>
                <h2 class="h5">@Localizer["No mirror runs yet"]</h2>
                <p class="text-muted mb-0">@Localizer["Results appear here after a scheduled or manual mirror run starts."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["Started"]</th>
                            <th>@Localizer["Duration"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Succeeded"]</th>
                            <th>@Localizer["Failed"]</th>
                            <th>@Localizer["Total repositories"]</th>
                            <th><span class="visually-hidden">@Localizer["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.History)
                        {
                            <tr>
                                <td class="text-nowrap"><span data-utc-time="@item.StartTime.ToHtmlDateTime()"></span></td>
                                <td>
                                    @if (item.EndTime.HasValue)
                                    {
                                        <span>@((item.EndTime.Value - item.StartTime).ToString(@"d\.hh\:mm\:ss"))</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["In progress"]</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.EndTime.HasValue)
                                    {
                                        <span class="badge bg-primary">@Localizer["Running"]</span>
                                    }
                                    else if (item.IsSuccess && string.IsNullOrEmpty(item.ErrorMessage))
                                    {
                                        <span class="badge bg-success">@Localizer["Succeeded"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@Localizer["Failed"]</span>
                                    }
                                </td>
                                <td>@item.SuccessCount</td>
                                <td>@item.FailureCount</td>
                                <td>@item.TotalCount</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">@Localizer["View results"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                <p class="text-muted mb-0">@string.Format(@Localizer["Showing {0}–{1} of {2} runs"].Value, (Model.CurrentPage - 1) * Model.PageSize + 1, Math.Min((long)Model.CurrentPage * Model.PageSize, Model.TotalCount), Model.TotalCount)</p>
                <nav aria-label="@Localizer["Mirror history pages"].Value">
                    <ul class="pagination flex-wrap mb-0">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1">@Localizer["First"]</a></li>
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" rel="prev">@Localizer["Previous"]</a></li>
                        }
                        <li class="page-item active"><span class="page-link" aria-current="page">@string.Format(@Localizer["Page {0} of {1}"].Value, Model.CurrentPage, Model.TotalPages)</span></li>
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" rel="next">@Localizer["Next"]</a></li>
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages">@Localizer["Last"]</a></li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
